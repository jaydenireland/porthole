@@ -0,0 +1,93 @@
+package main
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"syscall/js"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+)
+
+// Exercises openWebSocket against an in-process echo server. Run under Node
+// like TestDoRequestGlue.
+func TestOpenWebSocket(t *testing.T) {
+	up := websocket.Upgrader{
+		Subprotocols: []string{"p2"},
+		CheckOrigin:  func(*http.Request) bool { return true },
+	}
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		c, err := up.Upgrade(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer c.Close()
+		c.WriteMessage(websocket.TextMessage, []byte("hello "+r.Header.Get("Origin")))
+		for {
+			mt, data, err := c.ReadMessage()
+			if err != nil {
+				return
+			}
+			c.WriteMessage(mt, data)
+		}
+	}))
+	defer srv.Close()
+
+	events := make(chan string, 16)
+	cb := func(f func(a []js.Value) string) js.Func {
+		return js.FuncOf(func(this js.Value, a []js.Value) any { events <- f(a); return nil })
+	}
+	arg := js.ValueOf(map[string]any{
+		"url":       "ws" + strings.TrimPrefix(srv.URL, "http") + "/echo",
+		"protocols": []any{"p1", "p2"},
+		"headers":   []any{[]any{"Origin", "http://example.ts.net"}},
+	})
+	arg.Set("onOpen", cb(func(a []js.Value) string { return "open " + a[0].String() }))
+	arg.Set("onMessage", cb(func(a []js.Value) string {
+		if a[0].Type() == js.TypeString {
+			return "text " + a[0].String()
+		}
+		b := make([]byte, a[0].Length())
+		js.CopyBytesToGo(b, a[0])
+		return fmt.Sprintf("binary %v", b)
+	}))
+	arg.Set("onClose", cb(func(a []js.Value) string {
+		return fmt.Sprintf("close %d %q %v", a[0].Int(), a[1].String(), a[2].Bool())
+	}))
+	arg.Set("onError", cb(func(a []js.Value) string { return "error " + a[0].String() }))
+
+	sock := openWebSocket(&websocket.Dialer{}, arg)
+	expect := func(want string) {
+		t.Helper()
+		select {
+		case got := <-events:
+			if got != want {
+				t.Fatalf("event = %q, want %q", got, want)
+			}
+		case <-time.After(10 * time.Second):
+			t.Fatalf("timed out waiting for %q", want)
+		}
+	}
+	expect("open p2")
+	expect("text hello http://example.ts.net")
+	sock.Call("send", "héllo")
+	expect("text héllo")
+	bin := js.Global().Get("Uint8Array").New(3)
+	js.CopyBytesToJS(bin, []byte{0, 255, 7})
+	sock.Call("send", bin)
+	expect("binary [0 255 7]")
+	sock.Call("close", 4001, "bye")
+	// The echo server's close reply carries the code but no reason.
+	expect(`close 4001 "" true`)
+
+	// A failed dial reports an error, then an unclean close.
+	bad := js.ValueOf(map[string]any{"url": "ws://127.0.0.1:1/nope"})
+	bad.Set("onError", cb(func(a []js.Value) string { return "error" }))
+	bad.Set("onClose", cb(func(a []js.Value) string { return fmt.Sprintf("close %d %v", a[0].Int(), a[2].Bool()) }))
+	openWebSocket(&websocket.Dialer{}, bad)
+	expect("error")
+	expect("close 1006 false")
+}
