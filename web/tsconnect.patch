diff --git a/cmd/tsconnect/wasm/websocket_js.go b/cmd/tsconnect/wasm/websocket_js.go
new file mode 100644
index 0000000..a2a533e
--- /dev/null
+++ b/cmd/tsconnect/wasm/websocket_js.go
@@ -0,0 +1,191 @@
+// websocket() opens a WebSocket to a tailnet host and hands messages to JS
+// callbacks. The page-side WebSocket replacement uses it, because a service
+// worker cannot intercept WebSocket connections.
+
+package main
+
+import (
+	"context"
+	"errors"
+	"log"
+	"net/http"
+	"sync"
+	"syscall/js"
+	"time"
+
+	"github.com/gorilla/websocket"
+)
+
+func (i *jsIPN) websocket(arg js.Value) js.Value {
+	d := &websocket.Dialer{
+		NetDialContext:   i.dialer.UserDial,
+		HandshakeTimeout: 30 * time.Second,
+		// Share the cookie jar with request(), so a session started over
+		// HTTP also authenticates the socket.
+		Jar: i.httpClient().Jar,
+	}
+	return openWebSocket(d, arg)
+}
+
+type wsOut struct {
+	messageType int // websocket.TextMessage, BinaryMessage or CloseMessage
+	data        []byte
+}
+
+// openWebSocket reads
+//
+//	{url, protocols?: string[], headers?: [name, value][],
+//	 onOpen(protocol), onMessage(string | Uint8Array),
+//	 onClose(code, reason, wasClean), onError(message)}
+//
+// and returns {send(string | Uint8Array), close(code?, reason?)}.
+// onClose is always called exactly once, last.
+func openWebSocket(d *websocket.Dialer, arg js.Value) js.Value {
+	uint8Array := js.Global().Get("Uint8Array")
+	call := func(name string, args ...any) {
+		if f := arg.Get(name); f.Type() == js.TypeFunction {
+			f.Invoke(args...)
+		}
+	}
+
+	var argErr error
+	var url string
+	header := http.Header{}
+	dialer := *d
+	if arg.Type() != js.TypeObject || arg.Get("url").Type() != js.TypeString {
+		argErr = errors.New("usage: websocket({url, protocols?, headers?, onOpen, onMessage, onClose, onError})")
+	} else {
+		url = arg.Get("url").String()
+		if p := arg.Get("protocols"); p.InstanceOf(js.Global().Get("Array")) {
+			for n := 0; n < p.Length(); n++ {
+				dialer.Subprotocols = append(dialer.Subprotocols, p.Index(n).String())
+			}
+		}
+		if h := arg.Get("headers"); h.InstanceOf(js.Global().Get("Array")) {
+			for n := 0; n < h.Length(); n++ {
+				header.Add(h.Index(n).Index(0).String(), h.Index(n).Index(1).String())
+			}
+		}
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	// JS callbacks must not block, so sends are queued for a writer goroutine.
+	out := make(chan wsOut, 1024)
+	var closeOnce sync.Once
+	requestClose := func(code int, reason string) {
+		closeOnce.Do(func() {
+			select {
+			case out <- wsOut{websocket.CloseMessage, websocket.FormatCloseMessage(code, reason)}:
+			default:
+			}
+			// Give up on a peer that never answers the close (or a dial
+			// still in progress).
+			time.AfterFunc(5*time.Second, cancel)
+		})
+	}
+
+	go func() {
+		defer cancel()
+		if argErr != nil {
+			call("onError", argErr.Error())
+			call("onClose", websocket.CloseAbnormalClosure, "", false)
+			return
+		}
+		conn, _, err := dialer.DialContext(ctx, url, header)
+		if err != nil {
+			call("onError", err.Error())
+			call("onClose", websocket.CloseAbnormalClosure, "", false)
+			return
+		}
+		defer conn.Close()
+		// Unblock the reader when the context is cancelled.
+		go func() {
+			<-ctx.Done()
+			conn.Close()
+		}()
+		// Writer.
+		go func() {
+			for {
+				select {
+				case <-ctx.Done():
+					return
+				case m := <-out:
+					var err error
+					if m.messageType == websocket.CloseMessage {
+						err = conn.WriteControl(websocket.CloseMessage, m.data, time.Now().Add(5*time.Second))
+					} else {
+						err = conn.WriteMessage(m.messageType, m.data)
+					}
+					if err != nil {
+						log.Printf("websocket write: %v", err)
+						cancel()
+						return
+					}
+				}
+			}
+		}()
+
+		call("onOpen", conn.Subprotocol())
+		for {
+			messageType, data, err := conn.ReadMessage()
+			if err != nil {
+				var ce *websocket.CloseError
+				if errors.As(err, &ce) {
+					call("onClose", ce.Code, ce.Text, true)
+				} else {
+					if ctx.Err() == nil {
+						call("onError", err.Error())
+					}
+					call("onClose", websocket.CloseAbnormalClosure, "", false)
+				}
+				return
+			}
+			if messageType == websocket.TextMessage {
+				call("onMessage", string(data))
+			} else {
+				b := uint8Array.New(len(data))
+				js.CopyBytesToJS(b, data)
+				call("onMessage", b)
+			}
+		}
+	}()
+
+	return js.ValueOf(map[string]any{
+		"send": js.FuncOf(func(this js.Value, args []js.Value) any {
+			if len(args) != 1 {
+				return false
+			}
+			var m wsOut
+			if args[0].Type() == js.TypeString {
+				m = wsOut{websocket.TextMessage, []byte(args[0].String())}
+			} else if args[0].InstanceOf(uint8Array) {
+				b := make([]byte, args[0].Length())
+				js.CopyBytesToGo(b, args[0])
+				m = wsOut{websocket.BinaryMessage, b}
+			} else {
+				return false
+			}
+			select {
+			case out <- m:
+				return true
+			default:
+				// The peer is not reading fast enough; fail the socket
+				// rather than buffer without bound.
+				log.Printf("websocket send queue full; closing")
+				cancel()
+				return false
+			}
+		}),
+		"close": js.FuncOf(func(this js.Value, args []js.Value) any {
+			code, reason := websocket.CloseNoStatusReceived, ""
+			if len(args) > 0 && args[0].Type() == js.TypeNumber {
+				code = args[0].Int()
+			}
+			if len(args) > 1 && args[1].Type() == js.TypeString {
+				reason = args[1].String()
+			}
+			requestClose(code, reason)
+			return nil
+		}),
+	})
+}
