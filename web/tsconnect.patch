diff --git a/cmd/tsconnect/wasm/cookies_js.go b/cmd/tsconnect/wasm/cookies_js.go
new file mode 100644
index 0000000..6830020
--- /dev/null
+++ b/cmd/tsconnect/wasm/cookies_js.go
@@ -0,0 +1,104 @@
+// Cookie handling for request() and websocket().
+//
+// The service worker cannot set cookies on the responses it builds, so the
+// node keeps every cookie. Page scripts still expect document.cookie to
+// work, so the jar is split in two: cookies marked HttpOnly, which scripts
+// must never see, and the rest, which the injected page script reads and
+// writes through cookies() and setCookie().
+
+package main
+
+import (
+	"net/http"
+	"net/http/cookiejar"
+	"net/url"
+	"strings"
+	"syscall/js"
+
+	"golang.org/x/net/publicsuffix"
+)
+
+type splitJar struct {
+	httpOnly *cookiejar.Jar
+	script   *cookiejar.Jar
+}
+
+func newSplitJar() *splitJar {
+	opts := &cookiejar.Options{PublicSuffixList: publicsuffix.List}
+	h, _ := cookiejar.New(opts)
+	s, _ := cookiejar.New(opts)
+	return &splitJar{httpOnly: h, script: s}
+}
+
+// expired returns a cookie that deletes c from a jar.
+func expired(c *http.Cookie) *http.Cookie {
+	return &http.Cookie{Name: c.Name, Domain: c.Domain, Path: c.Path, MaxAge: -1}
+}
+
+// SetCookies stores cookies from an HTTP response. A cookie lives in exactly
+// one of the two jars, so it is removed from the other in case its HttpOnly
+// flag changed.
+func (j *splitJar) SetCookies(u *url.URL, cookies []*http.Cookie) {
+	for _, c := range cookies {
+		if c.HttpOnly {
+			j.httpOnly.SetCookies(u, []*http.Cookie{c})
+			j.script.SetCookies(u, []*http.Cookie{expired(c)})
+		} else {
+			j.script.SetCookies(u, []*http.Cookie{c})
+			j.httpOnly.SetCookies(u, []*http.Cookie{expired(c)})
+		}
+	}
+}
+
+// Cookies returns everything to send with a request to u.
+func (j *splitJar) Cookies(u *url.URL) []*http.Cookie {
+	return append(j.httpOnly.Cookies(u), j.script.Cookies(u)...)
+}
+
+// scriptCookies is what document.cookie shows on a page at u.
+func (j *splitJar) scriptCookies(u *url.URL) string {
+	var parts []string
+	for _, c := range j.script.Cookies(u) {
+		if c.Name == "" {
+			parts = append(parts, c.Value)
+		} else {
+			parts = append(parts, c.Name+"="+c.Value)
+		}
+	}
+	return strings.Join(parts, "; ")
+}
+
+// setFromScript applies a `document.cookie = line` assignment made on a page
+// at u. As in a browser, a script can neither create an HttpOnly cookie nor
+// replace one.
+func (j *splitJar) setFromScript(u *url.URL, line string) {
+	c, err := http.ParseSetCookie(line)
+	if err != nil || c.HttpOnly {
+		return
+	}
+	for _, existing := range j.httpOnly.Cookies(u) {
+		if existing.Name == c.Name {
+			return
+		}
+	}
+	j.script.SetCookies(u, []*http.Cookie{c})
+}
+
+// cookies(url) returns the document.cookie string for a page at url.
+func (i *jsIPN) cookies(rawURL string) any {
+	u, err := url.Parse(rawURL)
+	if err != nil {
+		return ""
+	}
+	i.httpClient()
+	return requestJar.scriptCookies(u)
+}
+
+// setCookie(url, line) applies a document.cookie assignment.
+func (i *jsIPN) setCookie(rawURL, line string) any {
+	if u, err := url.Parse(rawURL); err == nil {
+		i.httpClient()
+		requestJar.setFromScript(u, line)
+	}
+	return js.Undefined()
+}
diff --git a/cmd/tsconnect/wasm/cookies_js_test.go b/cmd/tsconnect/wasm/cookies_js_test.go
new file mode 100644
index 0000000..b4080b4
--- /dev/null
+++ b/cmd/tsconnect/wasm/cookies_js_test.go
@@ -0,0 +1,56 @@
+package main
+
+import (
+	"net/http"
+	"net/url"
+	"testing"
+)
+
+func TestSplitJar(t *testing.T) {
+	j := newSplitJar()
+	u, _ := url.Parse("http://app.tail1234.ts.net/dash")
+	other, _ := url.Parse("http://other.tail1234.ts.net/")
+	sent := func(u *url.URL) string {
+		s := ""
+		for _, c := range j.Cookies(u) {
+			s += c.Name + "=" + c.Value + ";"
+		}
+		return s
+	}
+	check := func(what, got, want string) {
+		t.Helper()
+		if got != want {
+			t.Errorf("%s = %q, want %q", what, got, want)
+		}
+	}
+
+	j.SetCookies(u, []*http.Cookie{
+		{Name: "sid", Value: "secret", Path: "/", HttpOnly: true},
+		{Name: "csrftoken", Value: "abc", Path: "/"},
+	})
+	check("script view", j.scriptCookies(u), "csrftoken=abc")
+	check("sent", sent(u), "sid=secret;csrftoken=abc;")
+	check("other host script view", j.scriptCookies(other), "")
+	check("other host sent", sent(other), "")
+
+	j.setFromScript(u, "theme=dark; Path=/; Max-Age=3600")
+	check("after script set", j.scriptCookies(u), "csrftoken=abc; theme=dark")
+	check("sent after script set", sent(u), "sid=secret;csrftoken=abc;theme=dark;")
+
+	// Scripts cannot replace or create HttpOnly cookies.
+	j.setFromScript(u, "sid=evil; Path=/")
+	j.setFromScript(u, "sneaky=1; HttpOnly")
+	check("sent after forbidden sets", sent(u), "sid=secret;csrftoken=abc;theme=dark;")
+
+	j.setFromScript(u, "theme=; Path=/; Max-Age=0")
+	check("after script delete", j.scriptCookies(u), "csrftoken=abc")
+
+	// The server turns a cookie HttpOnly: scripts lose it, and it is sent once.
+	j.SetCookies(u, []*http.Cookie{{Name: "csrftoken", Value: "xyz", Path: "/", HttpOnly: true}})
+	check("after HttpOnly flip, script view", j.scriptCookies(u), "")
+	check("after HttpOnly flip, sent", sent(u), "sid=secret;csrftoken=xyz;")
+
+	// ts.net is a public suffix, so one tailnet cannot set cookies for all.
+	j.SetCookies(u, []*http.Cookie{{Name: "wide", Value: "1", Domain: "ts.net", Path: "/"}})
+	check("public-suffix cookie rejected", j.scriptCookies(u), "")
+}
diff --git a/cmd/tsconnect/wasm/request_js.go b/cmd/tsconnect/wasm/request_js.go
new file mode 100644
index 0000000..467139f
--- /dev/null
+++ b/cmd/tsconnect/wasm/request_js.go
@@ -0,0 +1,158 @@
+// request() is a fuller alternative to fetch(): it takes a method, headers
+// and a binary body, and returns the status and headers as soon as they
+// arrive, with a reader for the body. It is what the page's service worker
+// uses to load tailnet sites into an iframe; reading the body in chunks is
+// what lets server-sent events and large downloads through.
+
+package main
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"net/http"
+	"sync"
+	"syscall/js"
+	"time"
+)
+
+var (
+	requestClientOnce sync.Once
+	requestClient     *http.Client
+	requestJar        *splitJar
+)
+
+// httpClient returns the shared client for request(). It dials over the
+// tailnet, keeps cookies in memory (see cookies_js.go), and never follows
+// redirects: the service worker has to see them to rewrite Location.
+func (i *jsIPN) httpClient() *http.Client {
+	requestClientOnce.Do(func() {
+		requestJar = newSplitJar()
+		requestClient = &http.Client{
+			Transport: &http.Transport{
+				DialContext:         i.dialer.UserDial,
+				MaxIdleConnsPerHost: 8,
+				IdleConnTimeout:     90 * time.Second,
+			},
+			Jar: requestJar,
+			CheckRedirect: func(*http.Request, []*http.Request) error {
+				return http.ErrUseLastResponse
+			},
+		}
+	})
+	return requestClient
+}
+
+func (i *jsIPN) request(arg js.Value) js.Value {
+	return doRequest(i.httpClient, arg)
+}
+
+// doRequest reads {url, method?, headers?: [name, value][], body?: Uint8Array}
+// and resolves to
+//
+//	{status, statusText, url, headers: [name, value][],
+//	 read(): Promise<Uint8Array | null>, cancel()}
+//
+// read() resolves to the next chunk of the body, or null at the end. Call
+// read() until it returns null or rejects, or call cancel(): either releases
+// the connection. Calls to read() must not overlap.
+// The client is looked up lazily so that argument errors reject the promise.
+func doRequest(client func() *http.Client, arg js.Value) js.Value {
+	// JS values are read here, on the calling goroutine, before going async.
+	var (
+		argErr  error
+		url     string
+		method  = http.MethodGet
+		headers [][2]string
+		body    []byte
+	)
+	if arg.Type() != js.TypeObject || arg.Get("url").Type() != js.TypeString {
+		argErr = errors.New("usage: request({url, method?, headers?, body?})")
+	} else {
+		url = arg.Get("url").String()
+		if m := arg.Get("method"); m.Type() == js.TypeString {
+			method = m.String()
+		}
+		if h := arg.Get("headers"); h.InstanceOf(js.Global().Get("Array")) {
+			for n := 0; n < h.Length(); n++ {
+				pair := h.Index(n)
+				headers = append(headers, [2]string{pair.Index(0).String(), pair.Index(1).String()})
+			}
+		}
+		if b := arg.Get("body"); b.InstanceOf(js.Global().Get("Uint8Array")) {
+			body = make([]byte, b.Length())
+			js.CopyBytesToGo(body, b)
+		}
+	}
+
+	return makePromise(func() (any, error) {
+		if argErr != nil {
+			return nil, argErr
+		}
+		var reqBody io.Reader
+		if len(body) > 0 {
+			reqBody = bytes.NewReader(body)
+		}
+		req, err := http.NewRequest(method, url, reqBody)
+		if err != nil {
+			return nil, err
+		}
+		for _, h := range headers {
+			req.Header.Add(h[0], h[1])
+		}
+		res, err := client().Do(req)
+		if err != nil {
+			return nil, err
+		}
+
+		resHeaders := []any{}
+		for name, values := range res.Header {
+			for _, v := range values {
+				resHeaders = append(resHeaders, []any{name, v})
+			}
+		}
+
+		var read, cancel js.Func
+		var finishOnce sync.Once
+		finish := func() {
+			finishOnce.Do(func() {
+				res.Body.Close()
+				read.Release()
+				cancel.Release()
+			})
+		}
+		read = js.FuncOf(func(this js.Value, args []js.Value) any {
+			return makePromise(func() (any, error) {
+				buf := make([]byte, 64<<10)
+				for {
+					n, err := res.Body.Read(buf)
+					if n > 0 {
+						chunk := js.Global().Get("Uint8Array").New(n)
+						js.CopyBytesToJS(chunk, buf[:n])
+						return chunk, nil
+					}
+					if err == io.EOF {
+						finish()
+						return js.Null(), nil
+					}
+					if err != nil {
+						finish()
+						return nil, err
+					}
+				}
+			})
+		})
+		cancel = js.FuncOf(func(this js.Value, args []js.Value) any {
+			finish()
+			return nil
+		})
+		return map[string]any{
+			"status":     res.StatusCode,
+			"statusText": http.StatusText(res.StatusCode),
+			"url":        res.Request.URL.String(),
+			"headers":    resHeaders,
+			"read":       read,
+			"cancel":     cancel,
+		}, nil
+	})
+}
diff --git a/cmd/tsconnect/wasm/request_js_test.go b/cmd/tsconnect/wasm/request_js_test.go
new file mode 100644
index 0000000..eab095b
--- /dev/null
+++ b/cmd/tsconnect/wasm/request_js_test.go
@@ -0,0 +1,156 @@
+package main
+
+import (
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"syscall/js"
+	"testing"
+	"time"
+)
+
+// Exercises the JS<->Go glue of doRequest against an in-process echo server.
+// Under Node, Go's js/wasm networking is an in-memory fake, so this needs no
+// tailnet: run it with -exec "$(go env GOROOT)/lib/wasm/go_js_wasm_exec".
+func TestDoRequestGlue(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		b, _ := io.ReadAll(r.Body)
+		w.Header().Set("X-Echo", "yes")
+		w.WriteHeader(201)
+		w.Write(append([]byte(r.Method+" "+r.Header.Get("X-Test")+" "), b...))
+	}))
+	defer srv.Close()
+	echo := srv.URL
+	body := js.Global().Get("Uint8Array").New(4)
+	js.CopyBytesToJS(body, []byte{0, 255, 'h', 'i'})
+	arg := js.ValueOf(map[string]any{
+		"url":     echo + "/echo?x=1",
+		"method":  "POST",
+		"headers": []any{[]any{"X-Test", "abc"}, []any{"Content-Type", "application/octet-stream"}},
+	})
+	arg.Set("body", body)
+
+	r, err := await(doRequest(func() *http.Client { return &http.Client{} }, arg))
+	if err != nil {
+		t.Fatalf("rejected: %v", err)
+	}
+	if got := r.Get("status").Int(); got != 201 {
+		t.Errorf("status = %d, want 201", got)
+	}
+	// The echo server replies with: method, X-Test header, then the raw body.
+	var got []byte
+	for {
+		chunk, err := await(r.Call("read"))
+		if err != nil {
+			t.Fatalf("read: %v", err)
+		}
+		if chunk.IsNull() {
+			break
+		}
+		got = append(got, bytesOf(chunk)...)
+	}
+	want := append([]byte("POST abc "), 0, 255, 'h', 'i')
+	if string(got) != string(want) {
+		t.Errorf("body = %q, want %q", got, want)
+	}
+	found := false
+	hs := r.Get("headers")
+	for n := 0; n < hs.Length(); n++ {
+		if hs.Index(n).Index(0).String() == "X-Echo" && hs.Index(n).Index(1).String() == "yes" {
+			found = true
+		}
+	}
+	if !found {
+		t.Errorf("response header X-Echo: yes not found")
+	}
+
+	// Bad arguments must reject, not panic.
+	if _, err := await(doRequest(func() *http.Client { return &http.Client{} }, js.ValueOf("nope"))); err == nil {
+		t.Errorf("bad argument resolved, want rejection")
+	}
+}
+
+// await blocks until a JS promise settles.
+func await(p js.Value) (js.Value, error) {
+	type result struct {
+		v   js.Value
+		err error
+	}
+	ch := make(chan result, 1)
+	then := js.FuncOf(func(this js.Value, a []js.Value) any { ch <- result{v: a[0]}; return nil })
+	catch := js.FuncOf(func(this js.Value, a []js.Value) any { ch <- result{err: errors.New(a[0].String())}; return nil })
+	defer then.Release()
+	defer catch.Release()
+	p.Call("then", then, catch)
+	r := <-ch
+	return r.v, r.err
+}
+
+func bytesOf(u8 js.Value) []byte {
+	b := make([]byte, u8.Length())
+	js.CopyBytesToGo(b, u8)
+	return b
+}
+
+// The body must be readable while the response is still being produced, and
+// cancel() must hang up on the server.
+func TestDoRequestStreams(t *testing.T) {
+	release := make(chan struct{})
+	hungUp := make(chan struct{})
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("one"))
+		w.(http.Flusher).Flush()
+		if r.URL.Path == "/forever" {
+			<-r.Context().Done()
+			close(hungUp)
+			return
+		}
+		<-release
+		w.Write([]byte("two"))
+	}))
+	defer srv.Close()
+	client := func() *http.Client { return &http.Client{} }
+	get := func(path string) js.Value {
+		t.Helper()
+		r, err := await(doRequest(client, js.ValueOf(map[string]any{"url": srv.URL + path})))
+		if err != nil {
+			t.Fatalf("GET %s rejected: %v", path, err)
+		}
+		return r
+	}
+	readString := func(r js.Value) string {
+		t.Helper()
+		chunk, err := await(r.Call("read"))
+		if err != nil {
+			t.Fatalf("read: %v", err)
+		}
+		if chunk.IsNull() {
+			return "<end>"
+		}
+		return string(bytesOf(chunk))
+	}
+
+	r := get("/paused")
+	if got := readString(r); got != "one" {
+		t.Fatalf("first chunk = %q, want %q (while the server is still paused)", got, "one")
+	}
+	close(release)
+	if got := readString(r); got != "two" {
+		t.Errorf("second chunk = %q, want %q", got, "two")
+	}
+	if got := readString(r); got != "<end>" {
+		t.Errorf("after the body = %q, want end", got)
+	}
+
+	r = get("/forever")
+	if got := readString(r); got != "one" {
+		t.Fatalf("first chunk = %q, want %q", got, "one")
+	}
+	r.Call("cancel")
+	select {
+	case <-hungUp:
+	case <-time.After(10 * time.Second):
+		t.Errorf("server did not see the client hang up after cancel()")
+	}
+}
