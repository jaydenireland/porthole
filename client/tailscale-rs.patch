index 0000000..070d017
--- /dev/null
+++ b/crates/utils/ts_http_util/src/rt.rs
@@ -0,0 +1,66 @@
+//! Where connection tasks run: tokio natively, the page's event loop in a browser.
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+mod imp {
+    /// A background task that is cancelled when this is dropped.
+    pub(crate) struct Task(#[allow(dead_code)] tokio::task::JoinSet<()>);
+
+    impl Task {
+        pub(crate) fn spawn(fut: impl Future<Output = ()> + Send + 'static) -> Self {
+            let mut set = tokio::task::JoinSet::new();
+            set.spawn(fut);
+            Self(set)
+        }
+    }
+
+    pub(crate) type Executor = hyper_util::rt::TokioExecutor;
+
+    pub(crate) fn executor() -> Executor {
+        hyper_util::rt::TokioExecutor::new()
+    }
+}
+
+#[cfg(all(target_arch = "wasm32", target_os = "unknown"))]
+mod imp {
+    use futures::future::{AbortHandle, abortable};
+
+    /// A background task that is cancelled when this is dropped.
+    pub(crate) struct Task(AbortHandle);
+
+    impl Task {
+        pub(crate) fn spawn(fut: impl Future<Output = ()> + 'static) -> Self {
+            let (fut, handle) = abortable(fut);
+            wasm_bindgen_futures::spawn_local(async move {
+                let _ = fut.await;
+            });
+            Self(handle)
+        }
+    }
+
+    impl Drop for Task {
+        fn drop(&mut self) {
+            self.0.abort();
+        }
+    }
+
+    /// Runs hyper's internal tasks on the page's event loop.
+    #[derive(Clone, Copy, Debug, Default)]
+    pub(crate) struct Executor;
+
+    impl<F> hyper::rt::Executor<F> for Executor
+    where
+        F: Future + 'static,
+    {
+        fn execute(&self, fut: F) {
+            wasm_bindgen_futures::spawn_local(async move {
+                drop(fut.await);
+            });
+        }
+    }
+
+    pub(crate) fn executor() -> Executor {
+        Executor
+    }
+}
