# Tailscale source that web/build.sh fetches and patches. Our changes to it
# are kept in web/tsconnect.patch.
/tailscale-src/

# The built Tailscale client. Run web/build.sh to produce it.
/web/node/

# The Rust client (work in progress, see client/README.md): the tailscale-rs
# source that client/build.sh fetches and patches (our changes are kept in
# client/tailscale-rs.patch), Cargo's build folder, and the built client.
/tailscale-rs-src/
/client/target/
/web/client/

# Cloudflare build output and tooling
node_modules/
/cloudflare/dist/
/cloudflare/.cache/
.wrangler/

.DS_Store
